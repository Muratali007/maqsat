# Локально ничего задавать не нужно: база — встроенный Postgres (PGlite) в ./data/pglite.
# Прод (Render): строка подключения Neon
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
# JWT_SECRET=длинная-случайная-строка   (на Render создаётся сам)

# ИИ-функции: 0 — показывать «скоро», 1 — включить (нужен ANTHROPIC_API_KEY)
NEXT_PUBLIC_AI_ENABLED=0
