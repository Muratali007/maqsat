# Supabase → Project Settings → API (или Connect)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ваш-anon-или-publishable-ключ

# ИИ-функции: 0 — показывать «скоро», 1 — включить (нужен ANTHROPIC_API_KEY)
NEXT_PUBLIC_AI_ENABLED=0

# console.anthropic.com → API Keys (только на сервере, в браузер не попадает)
ANTHROPIC_API_KEY=
# Модель ИИ-коуча (по умолчанию claude-opus-5-5)
# ANTHROPIC_MODEL=claude-opus-5-5
